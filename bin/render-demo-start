#!/bin/sh
set -eu

export APP_ENV=demo
export APP_DEBUG=false
export APP_URL="${RENDER_EXTERNAL_URL:-${APP_URL:-http://localhost:10000}}"
export DB_CONNECTION=sqlite
export DB_DATABASE=/app/database/database.sqlite
export SESSION_DRIVER=database
export CACHE_STORE=database
export QUEUE_CONNECTION=sync
export MAIL_MAILER=log
export LOG_CHANNEL=stderr
export SESSION_SECURE_COOKIE=true
export DEMO_MANAGER_EMAIL="${DEMO_MANAGER_EMAIL:-demo-manager@example.test}"

if [ -z "${APP_KEY:-}" ]; then
    export APP_KEY="$(php -r 'echo "base64:".base64_encode(random_bytes(32));')"
fi

touch "$DB_DATABASE"
php artisan migrate --force --no-interaction
php artisan motel:prepare-demo --no-interaction

exec php artisan serve --host=0.0.0.0 --port="${PORT:-10000}" --no-reload
